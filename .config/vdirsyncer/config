[general]
status_path = "~/.local/share/vdirsyncer/status/"

[pair google_calendar]
a = "google_calendar_local"
b = "google_calendar_remote"
collections = ["from b"]
metadata = ["displayname"]

[storage google_calendar_local]
type = "filesystem"
path = "~/.local/share/calendars/google/"
fileext = ".ics"

[storage google_calendar_remote]
type = "google_calendar"
token_file = "~/.config/vdirsyncer/google_token.json"
client_id.fetch = ["command", "cat", "~/.config/vdirsyncer/google_client_id"]
client_secret.fetch = ["command", "cat", "~/.config/vdirsyncer/google_client_secret"]
