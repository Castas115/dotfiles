# Plantilla de host.conf. Copiar a host.conf y ajustar por maquina.
# host.conf NO se versiona: es lo unico que puede diferir entre equipos.
#
# Historia: el 2026-07-27 se commiteo un PATH de Ubuntu en el env.conf
# compartido. En NixOS ese PATH no contiene /run/current-system/sw/bin ni
# /etc/profiles/per-user/$USER/bin, asi que Hyprland arrancaba sin poder
# ejecutar ni un exec-once: pantalla negra con solo el cursor.

# Reglas de ventana (sintaxis commaless, Hyprland 0.53+/0.55).
source = ~/.config/hypr/windows.conf

# --- Ubuntu 26.04 (nix en ~/.nix-profile) ---
# env = PATH,/home/jon/.nix-profile/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/snap/bin
# env = XDG_DATA_DIRS,/home/jon/.nix-profile/share:/usr/local/share:/usr/share:/var/lib/flatpak/exports/share:/home/jon/.local/share/flatpak/exports/share

# --- NixOS 25.05 ---
# No tocar PATH ni XDG_DATA_DIRS: NixOS los construye bien en el arranque
# de sesion, y sobreescribirlos rompe todo.
